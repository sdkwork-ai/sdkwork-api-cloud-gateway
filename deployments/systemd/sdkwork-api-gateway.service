# SDKWork API Cloud Gateway — Ubuntu systemd service unit.
#
# Canonical location: /usr/lib/systemd/system/sdkwork-api-gateway.service
# Service registration name keeps the product-facing unit id; filesystem
# paths follow topology.applicationCode `api_gateway`
# (APPLICATION_DEPLOY_LAYOUT_SPEC / RUNTIME_DIRECTORY_SPEC §4.1).
#
# Layout:
#   config   /etc/sdkwork/api_gateway/config.toml
#   env      /etc/sdkwork/api_gateway/api_gateway.env   (0640)
#   secrets  /etc/sdkwork/api_gateway/secrets/         (0600)
#   data     /var/lib/sdkwork/api_gateway
#   logs     /var/log/sdkwork/api_gateway
#   cache    /var/cache/sdkwork/api_gateway
#   run      /run/sdkwork/api_gateway
#   install  /opt/sdkwork/api_gateway
#
# PACKAGING_SPEC §5.5 rules honored here:
#   - installation-generated values live in the EnvironmentFile below, not in
#     this unit (unit files must not embed environment assignments);
#   - database credentials are never written to env/unit/config templates;
#     secrets come from /etc/sdkwork/database/database.secret (password_file)
#     or SDKWORK_* secret env injected by the operator.
# Install steps: see deployments/systemd/README.md and
# docs/guides/operator/INSTALLATION_STANDARDS.md.

[Unit]
Description=SDKWork API Cloud Gateway
After=network-online.target
Wants=network-online.target
Requires=sdkwork-knowledgebase-rpc.service
After=sdkwork-knowledgebase-rpc.service

[Service]
Type=simple
User=sdkwork
Group=sdkwork
EnvironmentFile=/etc/sdkwork/api_gateway/api_gateway.env
WorkingDirectory=/opt/sdkwork/api_gateway
ExecStartPre=/opt/sdkwork/api_gateway/bin/sdkwork-api-cloud-gateway --migrate-databases
ExecStart=/opt/sdkwork/api_gateway/bin/sdkwork-api-cloud-gateway
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
