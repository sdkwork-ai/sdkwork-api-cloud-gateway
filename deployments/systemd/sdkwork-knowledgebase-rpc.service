# SDKWork Knowledgebase RPC sidecar for the API Cloud Gateway package.

[Unit]
Description=SDKWork API Gateway Knowledgebase RPC
After=network-online.target
Wants=network-online.target
Before=sdkwork-api-gateway.service

[Service]
Type=simple
User=sdkwork
Group=sdkwork
EnvironmentFile=/etc/sdkwork/api_gateway/sdkwork-knowledgebase-rpc.env
WorkingDirectory=/opt/sdkwork/api_gateway
ExecStart=/opt/sdkwork/api_gateway/bin/knowledgebase-rpc-entrypoint
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
