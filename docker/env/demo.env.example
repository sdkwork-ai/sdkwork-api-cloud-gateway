GATEWAY_IM_ENVIRONMENT=demo
GATEWAY_IM_PRINCIPAL_DIRECTORY=postgres
GATEWAY_IM_ALLOW_ALL_PRINCIPALS=false
GATEWAY_IM_ID_NODE_ID=2
GATEWAY_KNOWLEDGEBASE_TENANT_ID=100001
GATEWAY_KNOWLEDGEBASE_ORGANIZATION_ID=1
GATEWAY_KNOWLEDGEBASE_ENVIRONMENT=demo
# --- External PostgreSQL / Redis (default; RUNTIME_DIRECTORY_SPEC §4.5) ---
# Dependency mode: external (default) or embedded (built-in PostgreSQL + Redis).
# Embedded is one deploy.sh flag away: bash deploy.sh --environment <env> --embedded
# or set GATEWAY_DEPS_MODE=embedded here before deploying.
GATEWAY_POSTGRES_HOST=host.docker.internal
GATEWAY_POSTGRES_PORT=5432
GATEWAY_CLOUDROUTER_REDIS_HOST=host.docker.internal
GATEWAY_CLOUDROUTER_REDIS_PORT=6379
GATEWAY_CLOUDROUTER_REDIS_PASSWORD=
# Shared external Redis: demo owns logical DB indexes 9/10 (dev 1/2, test 3/4,
# staging 5/6, production 7/8) so cache keys never collide across environments.
GATEWAY_CLOUDROUTER_REDIS_KEY_PREFIX=cloudrouter-demo
GATEWAY_RTC_STATE_REDIS_URL=redis://host.docker.internal:6379/9
GATEWAY_WEB_REDIS_URL=redis://host.docker.internal:6379/10
# TLS-required demo uses the host PostgreSQL CA bundle when sslmode=require.
# GATEWAY_POSTGRES_CA_FILE_MOUNT=./docker/ca/postgres-ca-bundle.crt
# GATEWAY_POSTGRES_SSL_CERT_FILE=/run/sdkwork/api-gateway/postgres-ca-bundle.crt
RUST_LOG=info

# Cloud Router web environment (web_security parse_environment): demo maps to
# the relaxed showcase posture; unset/unknown fails closed to production.
GATEWAY_CLOUDROUTER_ROUTER_ENVIRONMENT=demo

# --- Cloud Router fail-closed keys (development/demo posture ONLY) ---
# The embedded cloudrouter app-api assembly fail-closes without these six
# values (SDKWORK_CLOUDROUTER_API_KEY_PEPPER et al). These defaults match
# docker/env/development.env and are safe ONLY for local/test/demo stacks;
# staging and production MUST set operator-managed values instead.
GATEWAY_CLOUDROUTER_API_KEY_PEPPER=development-only-api-key-pepper-not-for-production
GATEWAY_CLOUDROUTER_TRUSTED_SUBJECT_SECRET=development-only-trusted-subject-secret
GATEWAY_CLOUDROUTER_APP_SESSION_SECRET=development-only-app-session-secret
GATEWAY_CLOUDROUTER_PAYMENT_WEBHOOK_SECRET=development-only-payment-webhook-secret
GATEWAY_CLOUDROUTER_INTERNAL_GATEWAY_SIGNING_SECRET=-zC9LRxQyR2B2LQLhoTMi1XQmH_phcEDDVBtX3sxtWY
GATEWAY_CLOUDROUTER_UPSTREAM_CREDENTIAL_KEY_RING={"activeKeyId":"development-local-v1","activeKey":"-H9WLZu6Ou7TZHIOSrl5axiRAK10KOkjrcFbYnWZabk","fingerprintKey":"HiYnoe11mwTzAyCWK0JVfhLahiVMRvZNi_IrxaZgh5o","decryptionKeys":[]}
