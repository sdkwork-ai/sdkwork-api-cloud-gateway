GATEWAY_IMAGE=sdkwork-api-cloud-gateway:local
GATEWAY_ENVIRONMENT=demo
GATEWAY_PROFILE_ID=standalone.demo
GATEWAY_PROVISION_PAYMENT_CREDENTIAL_KEY=true
GATEWAY_PROVISION_IAM_SIGNING_MASTER_SECRET=true
GATEWAY_PROVISION_KNOWLEDGEBASE_RPC_SECRETS=true
GATEWAY_IAM_ALLOWED_AUDIENCES=sdkwork-api-cloud-gateway
GATEWAY_HOST_PORT=3914
GATEWAY_CONTAINER_PORT=8080
GATEWAY_MIGRATE_ON_START=true
SDKWORK_DATABASE_AUTO_MIGRATE=false
GATEWAY_POSTGRES_DB=sdkwork_ai_demo
GATEWAY_POSTGRES_SCHEMA=sdkwork_ai_demo
GATEWAY_POSTGRES_USER=sdkwork_ai_demo
GATEWAY_POSTGRES_PASSWORD=<CHANGE_ME>
# Set an explicit percent-encoded SDKWORK_DATABASE_URL when credentials contain
# URL-reserved characters or when GATEWAY_POSTGRES_PASSWORD_FILE is used.
GATEWAY_POSTGRES_SSL_MODE=require
GATEWAY_POSTGRES_CA_FILE_MOUNT=./docker/ca/postgres-ca-bundle.crt
GATEWAY_POSTGRES_SSL_CERT_FILE=/run/sdkwork/api-gateway/postgres-ca-bundle.crt
# Demo is a fully isolated showcase tier (ENVIRONMENT_SPEC §4): the registered
# api-demo.* host family keeps the Host allowlist, while raw IP literals are
# accepted so demonstration clients can reach the gateway directly through the
# host IP without editing the allowlist per machine.
GATEWAY_SECURITY_ALLOW_IP_HOSTS=true
GATEWAY_ALLOWED_HOSTS=api-demo.sdkwork.com,api-demo.birdcoder.com,api-demo.noaper.com,api-demo.dtupay.com,api-demo.sdkwork.cn,api-demo.birdcoder.cn,api-demo.noaper.cn,api-demo.dtupay.cn,api-demo.skubc.com,api-demo.skubc.cn,api-demo.zowalk.com,api-demo.zowalk.cn,api-demo.offer86.com,api-demo.offer86.cn,api-demo.86offer.com,api-demo.86offer.cn,localhost:3914,127.0.0.1:3914
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3914,http://127.0.0.1:3914
GATEWAY_IM_ENVIRONMENT=demo
GATEWAY_IM_PRINCIPAL_DIRECTORY=postgres
GATEWAY_IM_ALLOW_ALL_PRINCIPALS=false
GATEWAY_IM_ID_NODE_ID=2
GATEWAY_KNOWLEDGEBASE_TENANT_ID=100001
GATEWAY_KNOWLEDGEBASE_ORGANIZATION_ID=1
GATEWAY_KNOWLEDGEBASE_ENVIRONMENT=demo
# --- External PostgreSQL / Redis (default; RUNTIME_DIRECTORY_SPEC §4.5) ---
# Dependency mode: external (default) or embedded (built-in PostgreSQL + Redis).
# Embedded is one deploy.sh flag away: bash deploy.sh --environment <env> --embedded
# or set GATEWAY_DEPS_MODE=embedded here before deploying.
GATEWAY_POSTGRES_HOST=host.docker.internal
GATEWAY_POSTGRES_PORT=5432
GATEWAY_CLOUDROUTER_REDIS_HOST=host.docker.internal
GATEWAY_CLOUDROUTER_REDIS_PORT=6379
GATEWAY_CLOUDROUTER_REDIS_PASSWORD=
# Shared external Redis: demo owns logical DB indexes 9/10 (dev 1/2, test 3/4,
# staging 5/6, production 7/8) so cache keys never collide across environments.
GATEWAY_CLOUDROUTER_REDIS_KEY_PREFIX=cloudrouter-demo
GATEWAY_RTC_STATE_REDIS_URL=redis://host.docker.internal:6379/9
GATEWAY_WEB_REDIS_URL=redis://host.docker.internal:6379/10
# TLS-required demo uses the host PostgreSQL CA bundle when sslmode=require.
# GATEWAY_POSTGRES_CA_FILE_MOUNT=./docker/ca/postgres-ca-bundle.crt
# GATEWAY_POSTGRES_SSL_CERT_FILE=/run/sdkwork/api-gateway/postgres-ca-bundle.crt
RUST_LOG=info

# Cloud Router web environment (web_security parse_environment): demo maps to
# the relaxed showcase posture; unset/unknown fails closed to production.
GATEWAY_CLOUDROUTER_ROUTER_ENVIRONMENT=demo

# --- Cloud Router fail-closed keys (development/demo posture ONLY) ---
# The embedded cloudrouter app-api assembly fail-closes without these six
# values (SDKWORK_CLOUDROUTER_API_KEY_PEPPER et al). These defaults match
# docker/env/development.env and are safe ONLY for local/test/demo stacks;
# staging and production MUST set operator-managed values instead.
GATEWAY_CLOUDROUTER_API_KEY_PEPPER=development-only-api-key-pepper-not-for-production
GATEWAY_CLOUDROUTER_TRUSTED_SUBJECT_SECRET=development-only-trusted-subject-secret
GATEWAY_CLOUDROUTER_APP_SESSION_SECRET=development-only-app-session-secret
GATEWAY_CLOUDROUTER_PAYMENT_WEBHOOK_SECRET=development-only-payment-webhook-secret
GATEWAY_CLOUDROUTER_INTERNAL_GATEWAY_SIGNING_SECRET=-zC9LRxQyR2B2LQLhoTMi1XQmH_phcEDDVBtX3sxtWY
GATEWAY_CLOUDROUTER_UPSTREAM_CREDENTIAL_KEY_RING={"activeKeyId":"development-local-v1","activeKey":"-H9WLZu6Ou7TZHIOSrl5axiRAK10KOkjrcFbYnWZabk","fingerprintKey":"HiYnoe11mwTzAyCWK0JVfhLahiVMRvZNi_IrxaZgh5o","decryptionKeys":[]}
# Installer-time workspace provisioning (entrypoint --provision-databases):
# role, database, schema, grants, and extensions are converged before module
# migration in every environment. Admin credentials are required only when the
# role/database must be created (or the role password converged) on a fresh host.
GATEWAY_DATABASE_PROVISION=true
# Memory cursor signing (>=32 bytes); demo uses the local-only default.
GATEWAY_MEMORY_CURSOR_SIGNING_KEY=demo-only-memory-cursor-signing-key-0123456789
# GATEWAY_POSTGRES_ADMIN_HOST=host.docker.internal
# GATEWAY_POSTGRES_ADMIN_PORT=5432
# GATEWAY_POSTGRES_ADMIN_DATABASE=postgres
# GATEWAY_POSTGRES_ADMIN_USERNAME=postgres
# GATEWAY_POSTGRES_ADMIN_PASSWORD=<CHANGE_ME>
# GATEWAY_POSTGRES_ADMIN_SSL_MODE=require
GATEWAY_CORS_CONSOLE_HOST_LABELS=account,admin,agent,agents,agents-admin,agents-app,agents-open,agentstudio,agentstudio-admin,agentstudio-app,aiot,aiot-admin,aiot-app,api,appbase,appstore,assets,audio,audio-api,birdcoder2,browser,canvas,cloudrouter,cms,code,codebox,community,company,console,course,customer-service,deploy,deploy-admin,deploy-app,dezhou,discovery,discovery-admin,doc,documents,documents-admin,documents-open,doudizhu,drama,drive,drive-internal,events,feeds,forum,gameengine,games,generations,github,github-workflow,harness,iam,im,image,inventory,invoice,kernel,knowledge,knowledgebase,knowledgebase-admin,llm,llm-admin,llm-app,llm-open,local-router,mahjong,mail,mcp,mem,membership,memory,memory-admin,memory-app,memory-open,merchandise,messaging,modelkit,models,music,news,notary,notary-admin,notes,order,partner,payment,portal,promotion,prompts,router,router-admin,router-open,rtc,search,server,server-admin,server-app,settings,shop,skills,terminal,tts,video,video-cut,voice,web-internal,web-provider-events,xiangqi
GATEWAY_CORS_CONSOLE_HOST_SUFFIX=-demo
GATEWAY_CORS_CONSOLE_HOST_SCHEMES=http,https
