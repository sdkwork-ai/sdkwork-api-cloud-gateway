GATEWAY_IMAGE=sdkwork-api-cloud-gateway:local
GATEWAY_ENVIRONMENT=staging
GATEWAY_PROFILE_ID=standalone.staging
GATEWAY_PROVISION_PAYMENT_CREDENTIAL_KEY=true
GATEWAY_PROVISION_IAM_SIGNING_MASTER_SECRET=true
GATEWAY_PROVISION_KNOWLEDGEBASE_RPC_SECRETS=true
GATEWAY_IAM_ALLOWED_AUDIENCES=sdkwork-api-cloud-gateway
GATEWAY_HOST_PORT=3912
GATEWAY_MIGRATE_ON_START=true
SDKWORK_DATABASE_AUTO_MIGRATE=false
GATEWAY_POSTGRES_DB=sdkwork_ai_staging
GATEWAY_POSTGRES_SCHEMA=sdkwork_ai_staging
GATEWAY_POSTGRES_USER=sdkwork_ai_staging
GATEWAY_POSTGRES_PASSWORD=<CHANGE_ME>
# Set an explicit percent-encoded SDKWORK_DATABASE_URL when credentials contain
# URL-reserved characters or when GATEWAY_POSTGRES_PASSWORD_FILE is used.
GATEWAY_POSTGRES_SSL_MODE=require
GATEWAY_ALLOWED_HOSTS=api-staging.sdkwork.com,api-staging.birdcoder.com,api-staging.dtupay.com,localhost:3912,127.0.0.1:3912
GATEWAY_CORS_ALLOWED_ORIGINS=https://api-staging.sdkwork.com,https://api-staging.birdcoder.com,https://api-staging.dtupay.com,app://dsh,app://birdcoder,app://sdkwork,app://dtupay
GATEWAY_IM_ENVIRONMENT=staging
GATEWAY_IM_PRINCIPAL_DIRECTORY=postgres
GATEWAY_IM_ALLOW_ALL_PRINCIPALS=false
GATEWAY_IM_ID_NODE_ID=2
GATEWAY_KNOWLEDGEBASE_TENANT_ID=100001
GATEWAY_KNOWLEDGEBASE_ORGANIZATION_ID=1
GATEWAY_WEBSERVER_ACME_PROFILE=staging
GATEWAY_WEBSERVER_ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
GATEWAY_WEBSERVER_ACME_CONTACT_EMAIL=admin@localhost
GATEWAY_WEBSERVER_NODE_UUID=api-gateway-staging-0
GATEWAY_KNOWLEDGEBASE_ENVIRONMENT=staging
# --- External PostgreSQL / Redis (WSL host-native or remote managed) ---
GATEWAY_POSTGRES_HOST=host.docker.internal
GATEWAY_POSTGRES_PORT=5432
GATEWAY_CLOUDROUTER_REDIS_HOST=host.docker.internal
GATEWAY_CLOUDROUTER_REDIS_PORT=6380
GATEWAY_CLOUDROUTER_REDIS_KEY_PREFIX=cloudrouter-staging
GATEWAY_RTC_STATE_REDIS_URL=redis://host.docker.internal:6380/5
GATEWAY_WEB_REDIS_URL=redis://host.docker.internal:6380/6
# TLS-required staging uses the host PostgreSQL CA bundle when sslmode=require.
# GATEWAY_POSTGRES_CA_FILE_MOUNT=./docker/ca/postgres-ca-bundle.crt
# GATEWAY_POSTGRES_SSL_CERT_FILE=/run/sdkwork/api-gateway/postgres-ca-bundle.crt
RUST_LOG=info
