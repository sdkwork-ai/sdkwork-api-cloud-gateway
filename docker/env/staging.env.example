GATEWAY_IM_ENVIRONMENT=staging
GATEWAY_IM_PRINCIPAL_DIRECTORY=postgres
GATEWAY_IM_ALLOW_ALL_PRINCIPALS=false
GATEWAY_IM_ID_NODE_ID=2
GATEWAY_KNOWLEDGEBASE_TENANT_ID=100001
GATEWAY_KNOWLEDGEBASE_ORGANIZATION_ID=1
GATEWAY_KNOWLEDGEBASE_ENVIRONMENT=staging
# --- External PostgreSQL / Redis (default; RUNTIME_DIRECTORY_SPEC §4.5) ---
# Dependency mode: external (default) or embedded (built-in PostgreSQL + Redis).
# Embedded is one deploy.sh flag away: bash deploy.sh --environment <env> --embedded
# or set GATEWAY_DEPS_MODE=embedded here before deploying.
GATEWAY_POSTGRES_HOST=host.docker.internal
GATEWAY_POSTGRES_PORT=5432
GATEWAY_CLOUDROUTER_REDIS_HOST=host.docker.internal
GATEWAY_CLOUDROUTER_REDIS_PORT=6379
GATEWAY_CLOUDROUTER_REDIS_PASSWORD=
GATEWAY_CLOUDROUTER_REDIS_KEY_PREFIX=cloudrouter-staging
GATEWAY_RTC_STATE_REDIS_URL=redis://host.docker.internal:6379/5
GATEWAY_WEB_REDIS_URL=redis://host.docker.internal:6379/6
# TLS-required staging uses the host PostgreSQL CA bundle when sslmode=require.
# GATEWAY_POSTGRES_CA_FILE_MOUNT=./docker/ca/postgres-ca-bundle.crt
# GATEWAY_POSTGRES_SSL_CERT_FILE=/run/sdkwork/api-gateway/postgres-ca-bundle.crt
RUST_LOG=info

# Cloud Router web environment (web_security parse_environment): demo maps to
# the relaxed showcase posture; unset/unknown fails closed to production.
GATEWAY_CLOUDROUTER_ROUTER_ENVIRONMENT=staging

# --- Cloud Router fail-closed keys (REQUIRED before first start) ---
# Staging runs the production security posture (fail-closed). Set all six
# operator-managed values before deploying; the stack will not start without them:/n# GATEWAY_CLOUDROUTER_API_KEY_PEPPER=<operator-managed>
# GATEWAY_CLOUDROUTER_TRUSTED_SUBJECT_SECRET=<operator-managed>
# GATEWAY_CLOUDROUTER_APP_SESSION_SECRET=<operator-managed>
# GATEWAY_CLOUDROUTER_PAYMENT_WEBHOOK_SECRET=<operator-managed>
# GATEWAY_CLOUDROUTER_INTERNAL_GATEWAY_SIGNING_SECRET=<operator-managed>
# GATEWAY_CLOUDROUTER_UPSTREAM_CREDENTIAL_KEY_RING=<operator-managed-json>
