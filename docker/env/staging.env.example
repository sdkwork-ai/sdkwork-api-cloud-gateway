GATEWAY_IMAGE=sdkwork-api-cloud-gateway:local
GATEWAY_ENVIRONMENT=staging
GATEWAY_PROFILE_ID=standalone.staging
GATEWAY_PROVISION_PAYMENT_CREDENTIAL_KEY=true
GATEWAY_PROVISION_IAM_SIGNING_MASTER_SECRET=true
GATEWAY_PROVISION_KNOWLEDGEBASE_RPC_SECRETS=true
GATEWAY_IAM_ALLOWED_AUDIENCES=sdkwork-api-cloud-gateway
GATEWAY_HOST_PORT=3912
# Listener port inside the container. 8080 keeps the deployment
# compatible with sdkwork-webserver sidecars, which dial the canonical
# upstream `sdkwork-api-cloud-gateway:8080` checkout-direct (never rewritten).
GATEWAY_CONTAINER_PORT=8080
GATEWAY_MIGRATE_ON_START=true
SDKWORK_DATABASE_AUTO_MIGRATE=false
GATEWAY_POSTGRES_DB=sdkwork_ai_staging
GATEWAY_POSTGRES_SCHEMA=sdkwork_ai_staging
GATEWAY_POSTGRES_USER=sdkwork_ai_staging
GATEWAY_POSTGRES_PASSWORD=<CHANGE_ME>
# Set an explicit percent-encoded SDKWORK_DATABASE_URL when credentials contain
# URL-reserved characters or when GATEWAY_POSTGRES_PASSWORD_FILE is used.
GATEWAY_POSTGRES_SSL_MODE=require
# Host allowlist keeps exact domain matching. To also reach the gateway
# directly through the host IP (health probes, operator smoke checks), either
# append the IP to GATEWAY_ALLOWED_HOSTS or enable IP-literal Host acceptance:
# GATEWAY_SECURITY_ALLOW_IP_HOSTS=true
GATEWAY_ALLOWED_HOSTS=api-staging.sdkwork.com,api-staging.birdcoder.com,api-staging.noaper.com,api-staging.dtupay.com,api-staging.sdkwork.cn,api-staging.birdcoder.cn,api-staging.noaper.cn,api-staging.dtupay.cn,api-staging.skubc.com,api-staging.skubc.cn,api-staging.zowalk.com,api-staging.zowalk.cn,api-staging.offer86.com,api-staging.offer86.cn,api-staging.86offer.com,api-staging.86offer.cn,localhost:3912,127.0.0.1:3912,gateway,sdkwork-api-cloud-gateway
