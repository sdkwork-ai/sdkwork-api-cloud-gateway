GATEWAY_IMAGE=sdkwork-api-cloud-gateway:local
GATEWAY_ENVIRONMENT=test
GATEWAY_PROFILE_ID=standalone.test
GATEWAY_PROVISION_PAYMENT_CREDENTIAL_KEY=true
GATEWAY_PROVISION_IAM_SIGNING_MASTER_SECRET=true
GATEWAY_PROVISION_KNOWLEDGEBASE_RPC_SECRETS=true
GATEWAY_IAM_ALLOWED_AUDIENCES=sdkwork-api-cloud-gateway
GATEWAY_HOST_PORT=3911
GATEWAY_MIGRATE_ON_START=true
SDKWORK_DATABASE_AUTO_MIGRATE=false
GATEWAY_POSTGRES_DB=sdkwork_ai_test
GATEWAY_POSTGRES_SCHEMA=sdkwork_ai_test
GATEWAY_POSTGRES_USER=sdkwork_ai_test
GATEWAY_POSTGRES_PASSWORD=<CHANGE_ME>
# Set an explicit percent-encoded SDKWORK_DATABASE_URL when credentials contain
# URL-reserved characters or when GATEWAY_POSTGRES_PASSWORD_FILE is used.
GATEWAY_POSTGRES_SSL_MODE=disable
GATEWAY_ALLOWED_HOSTS=api-test.sdkwork.com,api-test.birdcoder.com,api-test.dtupay.com,api-test.sdkwork.cn,api-test.birdcoder.cn,api-test.dtupay.cn,api-test.skubc.com,api-test.skubc.cn,api-test.zowalk.com,api-test.zowalk.cn,api-test.offer86.com,api-test.offer86.cn,api-test.86offer.com,api-test.86offer.cn,localhost:3911,127.0.0.1:3911
GATEWAY_CORS_ALLOWED_ORIGINS=http://api-test.sdkwork.com,http://api-test.birdcoder.com,http://api-test.dtupay.com,http://api-test.sdkwork.cn,http://api-test.birdcoder.cn,http://api-test.dtupay.cn,http://api-test.skubc.com,http://api-test.skubc.cn,http://api-test.zowalk.com,http://api-test.zowalk.cn,http://api-test.offer86.com,http://api-test.offer86.cn,http://api-test.86offer.com,http://api-test.86offer.cn,http://localhost:3911,http://127.0.0.1:3911,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
GATEWAY_IM_ENVIRONMENT=test
GATEWAY_IM_PRINCIPAL_DIRECTORY=postgres
GATEWAY_IM_ALLOW_ALL_PRINCIPALS=false
GATEWAY_IM_ID_NODE_ID=2
GATEWAY_KNOWLEDGEBASE_TENANT_ID=100001
GATEWAY_KNOWLEDGEBASE_ORGANIZATION_ID=1
GATEWAY_KNOWLEDGEBASE_ENVIRONMENT=test
# --- External PostgreSQL / Redis (default; RUNTIME_DIRECTORY_SPEC §4.5) ---
GATEWAY_POSTGRES_HOST=host.docker.internal
GATEWAY_POSTGRES_PORT=5432
GATEWAY_CLOUDROUTER_REDIS_HOST=host.docker.internal
GATEWAY_CLOUDROUTER_REDIS_PORT=6380
GATEWAY_CLOUDROUTER_REDIS_PASSWORD=
GATEWAY_CLOUDROUTER_REDIS_KEY_PREFIX=cloudrouter-test
GATEWAY_RTC_STATE_REDIS_URL=redis://host.docker.internal:6380/3
GATEWAY_WEB_REDIS_URL=redis://host.docker.internal:6380/4
RUST_LOG=info
