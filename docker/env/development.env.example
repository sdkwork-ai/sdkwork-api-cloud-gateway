GATEWAY_IMAGE=sdkwork-api-cloud-gateway:local
GATEWAY_ENVIRONMENT=development
GATEWAY_PROFILE_ID=standalone.development
GATEWAY_PROVISION_PAYMENT_CREDENTIAL_KEY=true
GATEWAY_PROVISION_IAM_SIGNING_MASTER_SECRET=true
GATEWAY_PROVISION_KNOWLEDGEBASE_RPC_SECRETS=true
GATEWAY_IAM_ALLOWED_AUDIENCES=sdkwork-api-cloud-gateway
GATEWAY_HOST_PORT=3910
GATEWAY_MIGRATE_ON_START=true
GATEWAY_DATABASE_AUTO_MIGRATE=false
GATEWAY_POSTGRES_DB=sdkwork_ai_dev
GATEWAY_POSTGRES_SCHEMA=sdkwork_ai_dev
GATEWAY_POSTGRES_USER=sdkwork_ai_dev
GATEWAY_POSTGRES_PASSWORD=<CHANGE_ME>
# Set an explicit percent-encoded GATEWAY_DATABASE_URL when credentials contain
# URL-reserved characters or when GATEWAY_POSTGRES_PASSWORD_FILE is used.
GATEWAY_POSTGRES_SSL_MODE=disable
GATEWAY_ALLOWED_HOSTS=api-dev.sdkwork.com,api-dev.birdcoder.com,api-dev.dtupay.com,localhost:3910,127.0.0.1:3910
GATEWAY_CORS_ALLOWED_ORIGINS=http://api-dev.sdkwork.com,http://api-dev.birdcoder.com,http://api-dev.dtupay.com,http://localhost:3910,http://127.0.0.1:3910
GATEWAY_IM_ENVIRONMENT=development
GATEWAY_IM_PRINCIPAL_DIRECTORY=postgres
GATEWAY_IM_ALLOW_ALL_PRINCIPALS=false
GATEWAY_IM_ID_NODE_ID=2
GATEWAY_KNOWLEDGEBASE_TENANT_ID=100001
GATEWAY_KNOWLEDGEBASE_ORGANIZATION_ID=1
GATEWAY_WEBSERVER_ACME_PROFILE=staging
GATEWAY_WEBSERVER_ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
GATEWAY_WEBSERVER_ACME_CONTACT_EMAIL=admin@localhost
GATEWAY_WEBSERVER_NODE_UUID=api-gateway-development-0
GATEWAY_KNOWLEDGEBASE_ENVIRONMENT=development
RUST_LOG=info
