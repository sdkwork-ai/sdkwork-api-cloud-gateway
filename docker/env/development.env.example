GATEWAY_IMAGE=sdkwork-api-cloud-gateway:local
GATEWAY_ENVIRONMENT=development
GATEWAY_PROFILE_ID=standalone.development
GATEWAY_PROVISION_PAYMENT_CREDENTIAL_KEY=true
GATEWAY_PROVISION_IAM_SIGNING_MASTER_SECRET=true
GATEWAY_PROVISION_KNOWLEDGEBASE_RPC_SECRETS=true
GATEWAY_IAM_ALLOWED_AUDIENCES=sdkwork-api-cloud-gateway
GATEWAY_HOST_PORT=3910
# Listener port inside the container. 8080 keeps the deployment
# compatible with sdkwork-webserver sidecars, which dial the canonical
# upstream `sdkwork-api-cloud-gateway:8080` checkout-direct (never rewritten).
GATEWAY_CONTAINER_PORT=8080
GATEWAY_MIGRATE_ON_START=true
SDKWORK_DATABASE_AUTO_MIGRATE=true
GATEWAY_POSTGRES_DB=sdkwork_ai_dev
GATEWAY_POSTGRES_SCHEMA=sdkwork_ai_dev
GATEWAY_POSTGRES_USER=sdkwork_ai_dev
GATEWAY_POSTGRES_PASSWORD=<CHANGE_ME>
# Set an explicit percent-encoded SDKWORK_DATABASE_URL when credentials contain
# URL-reserved characters or when GATEWAY_POSTGRES_PASSWORD_FILE is used.
GATEWAY_POSTGRES_SSL_MODE=disable
# Direct host-IP access (LAN clients, smoke checks): accept raw IP literal
# Host headers without listing every host IP here (security.allowIpHosts).
GATEWAY_SECURITY_ALLOW_IP_HOSTS=true
GATEWAY_ALLOWED_HOSTS=api-dev.sdkwork.com,api-dev.birdcoder.com,api-dev.noaper.com,api-dev.dtupay.com,api-dev.noaper.com,api-dev.sdkwork.cn,api-dev.birdcoder.cn,api-dev.noaper.cn,api-dev.dtupay.cn,api-dev.noaper.cn,api-dev.skubc.com,api-dev.noaper.com,api-dev.skubc.cn,api-dev.noaper.cn,api-dev.zowalk.com,api-dev.noaper.com,api-dev.zowalk.cn,api-dev.noaper.cn,api-dev.offer86.com,api-dev.noaper.com,api-dev.offer86.cn,api-dev.noaper.cn,api-dev.86offer.com,api-dev.noaper.com,api-dev.86offer.cn,api-dev.noaper.cn,localhost:3910,127.0.0.1:3910,gateway,sdkwork-api-cloud-gateway
GATEWAY_CORS_ALLOWED_ORIGINS=http://api-dev.sdkwork.com,http://api-dev.birdcoder.com,http://api-dev.noaper.com,http://api-dev.dtupay.com,http://api-dev.noaper.com,http://api-dev.sdkwork.cn,http://api-dev.birdcoder.cn,http://api-dev.noaper.cn,http://api-dev.dtupay.cn,http://api-dev.noaper.cn,http://api-dev.skubc.com,http://api-dev.noaper.com,http://api-dev.skubc.cn,http://api-dev.noaper.cn,http://api-dev.zowalk.com,http://api-dev.noaper.com,http://api-dev.zowalk.cn,http://api-dev.noaper.cn,http://api-dev.offer86.com,http://api-dev.noaper.com,http://api-dev.offer86.cn,http://api-dev.noaper.cn,http://api-dev.86offer.com,http://api-dev.noaper.com,http://api-dev.86offer.cn,http://api-dev.noaper.cn,http://localhost:3910,http://127.0.0.1:3910,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
GATEWAY_IM_ENVIRONMENT=development
GATEWAY_IM_PRINCIPAL_DIRECTORY=postgres
GATEWAY_IM_ALLOW_ALL_PRINCIPALS=false
GATEWAY_IM_ID_NODE_ID=2
GATEWAY_KNOWLEDGEBASE_TENANT_ID=100001
GATEWAY_KNOWLEDGEBASE_ORGANIZATION_ID=0
# 0 = tenant/personal scope (organization_id=0 in IAM); non-zero binds one org per deployment.
GATEWAY_KNOWLEDGEBASE_ENVIRONMENT=development
# --- External PostgreSQL / Redis (default; RUNTIME_DIRECTORY_SPEC §4.5) ---
# Dependency mode: external (default) or embedded (built-in PostgreSQL + Redis).
# Embedded is one deploy.sh flag away: bash deploy.sh --environment <env> --embedded
# or set GATEWAY_DEPS_MODE=embedded here before deploying.
# docker compose -f docker-compose.yml up -d  (no embedded postgres/redis)
GATEWAY_POSTGRES_HOST=host.docker.internal
GATEWAY_POSTGRES_PORT=5432
GATEWAY_CLOUDROUTER_REDIS_HOST=host.docker.internal
GATEWAY_CLOUDROUTER_REDIS_PORT=6379
GATEWAY_CLOUDROUTER_REDIS_PASSWORD=
GATEWAY_CLOUDROUTER_REDIS_KEY_PREFIX=cloudrouter-dev
# Shared Redis instance: isolate logical DB indexes per environment (dev 1/2).
GATEWAY_RTC_STATE_REDIS_URL=redis://host.docker.internal:6379/1
GATEWAY_WEB_REDIS_URL=redis://host.docker.internal:6379/2
# Copy from ../sdkwork-cloudrouter/.sdkwork/secrets/ when reusing an existing dev database.
# GATEWAY_CLOUDROUTER_UPSTREAM_CREDENTIAL_KEY_RING={"activeKeyId":"development-local-v1",...}
# GATEWAY_CLOUDROUTER_INTERNAL_GATEWAY_SIGNING_SECRET=<from internal-gateway-signing.development.secret>
RUST_LOG=info

# Cloud Router web environment (web_security parse_environment): demo maps to
# the relaxed showcase posture; unset/unknown fails closed to production.
GATEWAY_CLOUDROUTER_ROUTER_ENVIRONMENT=development

# --- Cloud Router fail-closed keys (development/demo posture ONLY) ---
# The embedded cloudrouter app-api assembly fail-closes without these six
# values (SDKWORK_CLOUDROUTER_API_KEY_PEPPER et al). These defaults match
# docker/env/development.env and are safe ONLY for local/test/demo stacks;
# staging and production MUST set operator-managed values instead.
GATEWAY_CLOUDROUTER_API_KEY_PEPPER=development-only-api-key-pepper-not-for-production
GATEWAY_CLOUDROUTER_TRUSTED_SUBJECT_SECRET=development-only-trusted-subject-secret
GATEWAY_CLOUDROUTER_APP_SESSION_SECRET=development-only-app-session-secret
GATEWAY_CLOUDROUTER_PAYMENT_WEBHOOK_SECRET=development-only-payment-webhook-secret
GATEWAY_CLOUDROUTER_INTERNAL_GATEWAY_SIGNING_SECRET=-zC9LRxQyR2B2LQLhoTMi1XQmH_phcEDDVBtX3sxtWY
GATEWAY_CLOUDROUTER_UPSTREAM_CREDENTIAL_KEY_RING={"activeKeyId":"development-local-v1","activeKey":"-H9WLZu6Ou7TZHIOSrl5axiRAK10KOkjrcFbYnWZabk","fingerprintKey":"HiYnoe11mwTzAyCWK0JVfhLahiVMRvZNi_IrxaZgh5o","decryptionKeys":[]}
