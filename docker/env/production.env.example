GATEWAY_IMAGE=registry.sdkwork.com/apps/sdkwork-api-cloud-gateway:<VERSION>
GATEWAY_ENVIRONMENT=production
GATEWAY_PROFILE_ID=standalone.production
GATEWAY_PROVISION_PAYMENT_CREDENTIAL_KEY=true
GATEWAY_PROVISION_IAM_SIGNING_MASTER_SECRET=true
GATEWAY_PROVISION_KNOWLEDGEBASE_RPC_SECRETS=true
GATEWAY_IAM_ALLOWED_AUDIENCES=sdkwork-api-cloud-gateway
GATEWAY_HOST_PORT=3913
# Listener port inside the container. 8080 keeps the deployment
# compatible with sdkwork-webserver sidecars, which dial the canonical
# upstream `sdkwork-api-cloud-gateway:8080` checkout-direct (never rewritten).
GATEWAY_CONTAINER_PORT=8080
# Set false on ordinary replicas when a separate elected release job migrates.
GATEWAY_MIGRATE_ON_START=true
SDKWORK_DATABASE_AUTO_MIGRATE=false
GATEWAY_POSTGRES_DB=sdkwork_ai_prod
GATEWAY_POSTGRES_SCHEMA=sdkwork_ai_prod
GATEWAY_POSTGRES_USER=sdkwork_ai_prod
GATEWAY_POSTGRES_PASSWORD=<CHANGE_ME>
# Set an explicit percent-encoded SDKWORK_DATABASE_URL when credentials contain
# URL-reserved characters or when GATEWAY_POSTGRES_PASSWORD_FILE is used.
GATEWAY_POSTGRES_SSL_MODE=require
# Host allowlist keeps exact domain matching in production. To reach the
# gateway directly through the host IP (health probes, load-balancer checks),
# either append the IP to GATEWAY_ALLOWED_HOSTS or enable IP-literal Host
# acceptance explicitly:
# GATEWAY_SECURITY_ALLOW_IP_HOSTS=true
GATEWAY_ALLOWED_HOSTS=api.sdkwork.com,api.birdcoder.com,api.noaper.com,api.dtupay.com,api.sdkwork.cn,api.birdcoder.cn,api.noaper.cn,api.dtupay.cn,api.skubc.com,api.skubc.cn,api.zowalk.com,api.zowalk.cn,api.offer86.com,api.offer86.cn,api.86offer.com,api.86offer.cn,localhost:3913,127.0.0.1:3913,gateway,sdkwork-api-cloud-gateway
GATEWAY_CORS_ALLOWED_ORIGINS=https://api.sdkwork.com,https://api.birdcoder.com,https://api.noaper.com,https://api.dtupay.com,https://api.sdkwork.cn,https://api.birdcoder.cn,https://api.noaper.cn,https://api.dtupay.cn,https://api.skubc.com,https://api.skubc.cn,https://api.zowalk.com,https://api.zowalk.cn,https://api.offer86.com,https://api.offer86.cn,https://api.86offer.com,https://api.86offer.cn,https://console.sdkwork.com,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com,https://router.sdkwork.com,https://router.birdcoder.com,https://router.dtupay.com,https://router.noaper.com,https://router.sdkwork.cn,https://router.birdcoder.cn,https://router.dtupay.cn,https://router.noaper.cn,https://router.skubc.com,https://router.skubc.cn,https://router.zowalk.com,https://router.zowalk.cn,https://router.offer86.com,https://router.offer86.cn,https://router.86offer.com,https://router.86offer.cn,https://appstore.sdkwork.com,https://appstore.birdcoder.com,https://appstore.dtupay.com,https://appstore.noaper.com,https://appstore.sdkwork.cn,https://appstore.birdcoder.cn,https://appstore.dtupay.cn,https://appstore.noaper.cn,https://appstore.skubc.com,https://appstore.skubc.cn,https://appstore.zowalk.com,https://appstore.zowalk.cn,https://appstore.offer86.com,https://appstore.offer86.cn,https://appstore.86offer.com,https://appstore.86offer.cn,https://drive.sdkwork.com,https://drive.birdcoder.com,https://drive.dtupay.com,https://drive.noaper.com,https://drive.sdkwork.cn,https://drive.birdcoder.cn,https://drive.dtupay.cn,https://drive.noaper.cn,https://drive.skubc.com,https://drive.skubc.cn,https://drive.zowalk.com,https://drive.zowalk.cn,https://drive.offer86.com,https://drive.offer86.cn,https://drive.86offer.com,https://drive.86offer.cn,https://iam.sdkwork.com,https://iam.birdcoder.com,https://iam.dtupay.com,https://iam.noaper.com,https://iam.sdkwork.cn,https://iam.birdcoder.cn,https://iam.dtupay.cn,https://iam.noaper.cn,https://iam.skubc.