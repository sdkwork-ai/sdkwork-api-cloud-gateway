GATEWAY_IMAGE=registry.sdkwork.com/sdkwork-api-cloud-gateway:<VERSION>
GATEWAY_ENVIRONMENT=production
GATEWAY_PROFILE_ID=standalone.production
GATEWAY_PROVISION_PAYMENT_CREDENTIAL_KEY=true
GATEWAY_HOST_PORT=3913
# Set false on ordinary replicas when a separate elected release job migrates.
GATEWAY_MIGRATE_ON_START=true
GATEWAY_DATABASE_AUTO_MIGRATE=false
GATEWAY_POSTGRES_DB=sdkwork_ai_prod
GATEWAY_POSTGRES_SCHEMA=sdkwork_ai_prod
GATEWAY_POSTGRES_USER=sdkwork_ai_prod
GATEWAY_POSTGRES_PASSWORD=<CHANGE_ME>
GATEWAY_POSTGRES_SSL_MODE=disable
GATEWAY_ALLOWED_HOSTS=api.sdkwork.com,api.birdcoder.com,api.dtupay.com,localhost:3913,127.0.0.1:3913
GATEWAY_CORS_ALLOWED_ORIGINS=https://api.sdkwork.com,https://api.birdcoder.com,https://api.dtupay.com
GATEWAY_IM_ENVIRONMENT=production
GATEWAY_IM_ALLOW_ALL_PRINCIPALS=false
GATEWAY_KNOWLEDGEBASE_ENVIRONMENT=production
GATEWAY_CLOUDROUTER_API_KEY_PEPPER=<CHANGE_ME>
GATEWAY_CLOUDROUTER_UPSTREAM_CREDENTIAL_KEY_RING=<CHANGE_ME>
GATEWAY_CLOUDROUTER_TRUSTED_SUBJECT_SECRET=<CHANGE_ME>
GATEWAY_CLOUDROUTER_APP_SESSION_SECRET=<CHANGE_ME>
GATEWAY_CLOUDROUTER_PAYMENT_WEBHOOK_SECRET=<CHANGE_ME>
GATEWAY_CLOUDROUTER_INTERNAL_GATEWAY_SIGNING_SECRET=<CHANGE_ME>
# External managed PostgreSQL deployments should switch SSL mode to require.
RUST_LOG=info
