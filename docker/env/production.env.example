m,https://assets.sdkwork.cn,https://assets.birdcoder.cn,https://assets.dtupay.cn,https://assets.noaper.cn,https://assets.skubc.com,https://assets.skubc.cn,https://assets.zowalk.com,https://assets.zowalk.cn,https://assets.offer86.com,https://assets.offer86.cn,https://assets.86offer.com,https://assets.86offer.cn,https://community.sdkwork.com,https://community.birdcoder.com,https://community.dtupay.com,https://community.noaper.com,https://community.sdkwork.cn,https://community.birdcoder.cn,https://community.dtupay.cn,https://community.noaper.cn,https://community.skubc.com,https://community.skubc.cn,https://community.zowalk.com,https://community.zowalk.cn,https://community.offer86.com,https://community.offer86.cn,https://community.86offer.com,https://community.86offer.cn
GATEWAY_IM_ENVIRONMENT=production
GATEWAY_IM_PRINCIPAL_DIRECTORY=postgres
GATEWAY_IM_ALLOW_ALL_PRINCIPALS=false
GATEWAY_IM_ID_NODE_ID=2
GATEWAY_KNOWLEDGEBASE_TENANT_ID=100001
GATEWAY_KNOWLEDGEBASE_ORGANIZATION_ID=1
GATEWAY_KNOWLEDGEBASE_ENVIRONMENT=production
# Optional HashiCorp Vault KV v2 backend for Knowledgebase Provider credentials.
# When omitted, mount secret files below knowledgebase/provider/ in the
# gateway secret volume; Vault takes precedence when both sources are present.
GATEWAY_VAULT_ADDR=
GATEWAY_VAULT_TOKEN=
GATEWAY_VAULT_MOUNT=secret
GATEWAY_VAULT_NAMESPACE=
GATEWAY_CLOUDROUTER_API_KEY_PEPPER=<CHANGE_ME>
GATEWAY_CLOUDROUTER_UPSTREAM_CREDENTIAL_KEY_RING=<CHANGE_ME>
GATEWAY_CLOUDROUTER_TRUSTED_SUBJECT_SECRET=<CHANGE_ME>
GATEWAY_CLOUDROUTER_APP_SESSION_SECRET=<CHANGE_ME>
GATEWAY_CLOUDROUTER_PAYMENT_WEBHOOK_SECRET=<CHANGE_ME>
GATEWAY_CLOUDROUTER_INTERNAL_GATEWAY_SIGNING_SECRET=<CHANGE_ME>
# --- External PostgreSQL / Redis (default; RUNTIME_DIRECTORY_SPEC §4.5) ---
# Dependency mode: external (default) or embedded (built-in PostgreSQL + Redis).
# Embedded is one deploy.sh flag away: bash deploy.sh --environment <env> --embedded
# or set GATEWAY_DEPS_MODE=embedded here before deploying.
# Edit these fields to point at your managed database; then redeploy:
#   scripts/deploy-docker-environment.sh production --validate
# For passwords with URL-reserved characters, set SDKWORK_DATABASE_URL instead.
# GATEWAY_POSTGRES_HOST=db.example.com
# GATEWAY_POSTGRES_PORT=5432
# GATEWAY_POSTGRES_DB=sdkwork_ai_prod
# GATEWAY_POSTGRES_SCHEMA=sdkwork_ai_prod
# GATEWAY_POSTGRES_USER=sdkwork_ai_prod
# GATEWAY_POSTGRES_PASSWORD=<CHANGE_ME>
# GATEWAY_POSTGRES_SSL_MODE=require
GATEWAY_POSTGRES_HOST=host.docker.internal
GATEWAY_POSTGRES_PORT=5432
GATEWAY_CLOUDROUTER_REDIS_HOST=host.docker.internal
GATEWAY_CLOUDROUTER_REDIS_PORT=6379
GATEWAY_CLOUDROUTER_REDIS_PASSWORD=
GATEWAY_CLOUDROUTER_REDIS_KEY_PREFIX=cloudrouter-prod
GATEWAY_RTC_STATE_REDIS_URL=redis://host.docker.internal:6379/7
GATEWAY_WEB_REDIS_URL=redis://host.docker.internal:6379/8
GATEWAY_POSTGRES_CA_FILE_MOUNT=./docker/ca/postgres-ca-bundle.crt
GATEWAY_POSTGRES_SSL_CERT_FILE=/run/sdkwork/api-gateway/postgres-ca-bundle.crt
RUST_LOG=info

# Cloud Router web environment (web_security parse_environment): demo maps to
# the relaxed showcase posture; unset/unknown fails closed to production.
GATEWAY_CLOUDROUTER_ROUTER_ENVIRONMENT=production
