# sdkwork-api-cloud-gateway docker compose environment template.
# Copy to the repository root as `.env` and adjust values:
#   cp docker/.env.example .env
# docker compose reads `.env` next to docker-compose.yml automatically.
# Every value below has a built-in local-development default, so this file is
# optional; it exists to make deployment-time configuration explicit.

# --- Host port mapping (391x reserved band for this gateway's docker stack) ---
# Container listens on 3900; 3910 is the default host side. Collides with
# nothing in the dev band (3900-3902) or the cloudrouter container (3903).
# Per-environment host ports (full matrix in deployments/README.md):
#   development/standalone  GATEWAY_HOST_PORT=3910  (default)
#   test                    GATEWAY_HOST_PORT=3911
#   production              GATEWAY_HOST_PORT=3912
GATEWAY_HOST_PORT=3910

# --- Process log level (tracing reads RUST_LOG directly) ---
RUST_LOG=info

# --- Gateway resource guardrails (docker compose deploy limits) ---
GATEWAY_CPU_LIMIT=2.0
GATEWAY_MEMORY_LIMIT=2g
GATEWAY_CPU_RESERVATION=0.5
GATEWAY_MEMORY_RESERVATION=512m

# --- Connection pools (foundation suite bootstraps 46 modules at startup) ---
GATEWAY_DATABASE_MAX_CONNECTIONS=50
GATEWAY_DATABASE_MIN_CONNECTIONS=5
GATEWAY_DATABASE_ACQUIRE_TIMEOUT=30
GATEWAY_DATABASE_IDLE_TIMEOUT=600
GATEWAY_DATABASE_MAX_LIFETIME=1800
# PostgreSQL server-side connection ceiling (default 200).
PG_MAX_CONNECTIONS=200

# --- PostgreSQL (compose `postgres` service) ---
GATEWAY_POSTGRES_DB=sdkwork_ai_prod
GATEWAY_POSTGRES_USER=sdkwork_ai_prod
# Change this password for anything beyond a local test deployment.
GATEWAY_POSTGRES_PASSWORD=sdkwork_ai_prod

# --- Browser CORS allow-list (API plane) ---
# The gateway runs in production posture, so every origin that calls the API
# from a browser must be listed here (comma/space separated). Defaults cover
# the docker test domains (testapidocker.* and testapi.*) plus local host ports.
GATEWAY_CORS_ALLOWED_ORIGINS=http://testapidocker.sdkwork.com,http://testapidocker.birdcoder.com,http://testapidocker.dtupay.com,http://testapi.sdkwork.com,http://testapi.birdcoder.com,http://testapi.dtupay.com,http://localhost:3910,http://127.0.0.1:3910

# --- Gateway host allowlist ---
# Requests whose Host header is not listed here are rejected with 421.
GATEWAY_ALLOWED_HOSTS=testapidocker.sdkwork.com,testapidocker.birdcoder.com,testapidocker.dtupay.com,testapi.sdkwork.com,testapi.birdcoder.com,testapi.dtupay.com,localhost:3910,127.0.0.1:3910

# --- Production domains (real DNS + TLS at nginx) ---
# For production traffic through api.sdkwork.com / api.birdcoder.com /
# api.dtupay.com, switch the allowlist and CORS origins to the production
# names (the nginx site docker/nginx/api-gateway-production.conf and
# [security].allowedHosts must agree):
#   GATEWAY_ALLOWED_HOSTS=api.sdkwork.com,api.birdcoder.com,api.dtupay.com
#   GATEWAY_CORS_ALLOWED_ORIGINS=https://api.sdkwork.com,https://api.birdcoder.com,https://api.dtupay.com,https://console.sdkwork.com

# --- External PostgreSQL override (production) ---
# Set these to point the container at managed services instead of the compose
# service, and unset/replace the compose dependency wiring accordingly.
# GATEWAY_POSTGRES_HOST=db.example.com
# GATEWAY_POSTGRES_PORT=5432

# --- External services mode (existing PostgreSQL + Redis) ---
# To run the gateway against databases/Redis that already exist (no built-in
# postgres/redis containers), start with the external override file:
#
#   docker compose -f docker-compose.yml -f docker-compose.external.yml up -d
#
# and configure the connection here. GATEWAY_POSTGRES_HOST may be
# host.docker.internal to reach a service on the docker host (the override
# adds the host-gateway extra host), or any reachable address.
# The external PostgreSQL must already have database `sdkwork_ai_prod` with a
# same-named schema (create it with docker/postgres/external-schema.sql).
#
# GATEWAY_POSTGRES_HOST=host.docker.internal
# GATEWAY_POSTGRES_PORT=5432
# GATEWAY_POSTGRES_DB=sdkwork_ai_prod
# GATEWAY_POSTGRES_USER=sdkwork_ai_prod
# GATEWAY_POSTGRES_PASSWORD=change-me
# GATEWAY_POSTGRES_SSL_MODE=disable
#
# GATEWAY_CLOUDROUTER_REDIS_HOST=host.docker.internal
# GATEWAY_CLOUDROUTER_REDIS_PORT=6379
# GATEWAY_CLOUDROUTER_REDIS_DATABASE=0
# GATEWAY_CLOUDROUTER_REDIS_USERNAME=
# GATEWAY_CLOUDROUTER_REDIS_PASSWORD=           # leave empty for LAN passwordless
# GATEWAY_CLOUDROUTER_REDIS_TLS=false
# GATEWAY_CLOUDROUTER_REDIS_KEY_PREFIX=cloudrouter
