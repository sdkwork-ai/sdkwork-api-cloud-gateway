# sdkwork-api-cloud-gateway docker compose environment template.
# Copy to the repository root as `.env` and adjust values:
#   cp docker/.env.example .env
# docker compose reads `.env` next to docker-compose.yml automatically.
# Every value below has a built-in local-development default, so this file is
# optional; it exists to make deployment-time configuration explicit.
# Environment-specific templates live under docker/env/. Copy exactly one to
# a private env file and pass it with `docker compose --env-file <file>`.

GATEWAY_IMAGE=sdkwork-api-cloud-gateway:local
GATEWAY_ENVIRONMENT=development
GATEWAY_PROFILE_ID=standalone.development

# Single-node compose creates the Payment credential key once in the durable
# gateway-secrets volume. Multi-replica deployments must set this to false and
# mount one shared operator/KMS-managed key at the configured secret path.
GATEWAY_PROVISION_PAYMENT_CREDENTIAL_KEY=true
# IAM tenant signing-key encryption uses one stable master secret. Single-node
# compose persists it in gateway-secrets; replicas mount a shared managed key.
GATEWAY_PROVISION_IAM_SIGNING_MASTER_SECRET=true
GATEWAY_IAM_ALLOWED_AUDIENCES=sdkwork-api-cloud-gateway
# The bundled Knowledgebase RPC sidecar provisions persistent single-node
# mTLS and caller-signing material in gateway-secrets. Replicas must disable
# this and mount one operator-managed secret set instead.
GATEWAY_PROVISION_KNOWLEDGEBASE_RPC_SECRETS=true

# --- Host port mapping (391x reserved band for this gateway's docker stack) ---
# Container listens on 3900; 3910 is the default host side. Collides with
# nothing in the dev band (3900-3902) or the cloudrouter container (3903).
# Per-environment host ports (full matrix in deployments/README.md):
#   development/standalone  GATEWAY_HOST_PORT=3910  (default)
#   test                    GATEWAY_HOST_PORT=3911
#   staging                 GATEWAY_HOST_PORT=3912
#   production              GATEWAY_HOST_PORT=3913
GATEWAY_HOST_PORT=3910

# --- Process log level (tracing reads RUST_LOG directly) ---
RUST_LOG=info

# --- Gateway resource guardrails (docker compose deploy limits) ---
GATEWAY_CPU_LIMIT=2.0
GATEWAY_MEMORY_LIMIT=2g
GATEWAY_CPU_RESERVATION=0.5
GATEWAY_MEMORY_RESERVATION=512m

# --- Connection pools (foundation suite bootstraps 46 modules at startup) ---
SDKWORK_DATABASE_MAX_CONNECTIONS=50
SDKWORK_DATABASE_MIN_CONNECTIONS=5
SDKWORK_DATABASE_ACQUIRE_TIMEOUT=30
SDKWORK_DATABASE_IDLE_TIMEOUT=600
SDKWORK_DATABASE_MAX_LIFETIME=1800
# PostgreSQL server-side connection ceiling (default 200).
PG_MAX_CONNECTIONS=200

# --- PostgreSQL (compose `postgres` service) ---
GATEWAY_POSTGRES_DB=sdkwork_ai_prod
GATEWAY_POSTGRES_SCHEMA=sdkwork_ai_prod
GATEWAY_POSTGRES_USER=sdkwork_ai_prod
# Change this password for anything beyond a local test deployment.
GATEWAY_POSTGRES_PASSWORD=sdkwork_ai_prod

# --- IM principal directory ---
# The dynamic PostgreSQL directory admits IAM-authenticated users on first
# sight and records the decision for audit. Do not enable allow-all outside
# disposable development processes.
GATEWAY_IM_ENVIRONMENT=development
GATEWAY_IM_PRINCIPAL_DIRECTORY=postgres
GATEWAY_IM_ALLOW_ALL_PRINCIPALS=false
# Must be unique for every concurrently running gateway replica (0-1023).
GATEWAY_IM_ID_NODE_ID=2
GATEWAY_KNOWLEDGEBASE_TENANT_ID=100001
GATEWAY_KNOWLEDGEBASE_ORGANIZATION_ID=1

# --- Embedded WebServer certificate lifecycle ---
# Use the ACME staging directory outside production to avoid CA rate limits.
GATEWAY_WEBSERVER_ACME_PROFILE=staging
GATEWAY_WEBSERVER_ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
GATEWAY_WEBSERVER_ACME_CONTACT_EMAIL=admin@localhost
# Must be unique for each concurrently running gateway replica.
GATEWAY_WEBSERVER_NODE_UUID=api-gateway-development-0
# Override when the database password requires URL encoding. The same URL is
# consumed by the gateway's IM runtime and the bundled Knowledgebase RPC host.
# SDKWORK_DATABASE_URL=postgresql://user:encoded-password@postgres:5432/sdkwork_ai_dev?sslmode=disable&options=-c%20search_path%3Dsdkwork_ai_dev
# Override only when an operator-managed Knowledgebase RPC host is used.
# GATEWAY_KNOWLEDGEBASE_RPC_ENDPOINT=https://knowledgebase-rpc.example.com:50054

# --- Browser CORS allow-list (API plane) ---
# The gateway runs in production posture, so every origin that calls the API
# from a browser must be listed here (comma/space separated). Defaults cover
# the development domains (`api-dev.*`) plus local host ports.
GATEWAY_CORS_ALLOWED_ORIGINS=http://api-dev.sdkwork.com,http://api-dev.birdcoder.com,http://api-dev.dtupay.com,http://localhost:3910,http://127.0.0.1:3910,app://dsh,app://birdcoder,app://sdkwork,app://dtupay

# --- Gateway host allowlist ---
# Requests whose Host header is not listed here are rejected with 421.
GATEWAY_ALLOWED_HOSTS=api-dev.sdkwork.com,api-dev.birdcoder.com,api-dev.dtupay.com,localhost:3910,127.0.0.1:3910

# --- Production domains (real DNS + TLS at nginx) ---
# For production traffic through api.sdkwork.com / api.birdcoder.com /
# api.dtupay.com, switch the allowlist and CORS origins to the production
# names (the nginx site docker/nginx/api.sdkwork.com.conf and
# [security].allowedHosts must agree):
#   GATEWAY_ALLOWED_HOSTS=api.sdkwork.com,api.birdcoder.com,api.dtupay.com
#   GATEWAY_CORS_ALLOWED_ORIGINS=https://api.sdkwork.com,https://api.birdcoder.com,https://api.dtupay.com,https://console.sdkwork.com,app://dsh,app://birdcoder,app://sdkwork,app://dtupay

# --- External PostgreSQL override (production) ---
# Set these to point the container at managed services instead of the compose
# service, and unset/replace the compose dependency wiring accordingly.
# GATEWAY_POSTGRES_HOST=db.example.com
# GATEWAY_POSTGRES_PORT=5432
# GATEWAY_POSTGRES_SSL_CERT_FILE=/run/secrets/sdkwork/api-gateway/postgres-ca.crt

# --- External services mode (existing PostgreSQL + Redis) ---
# To run the gateway against databases/Redis that already exist (no built-in
# postgres/redis containers), start with the external override file:
#
#   docker compose -f docker-compose.yml -f docker-compose.external.yml up -d
#
# and configure the connection here. GATEWAY_POSTGRES_HOST may be
# host.docker.internal to reach a service on the docker host (the override
# adds the host-gateway extra host), or any reachable address.
# The external PostgreSQL must already have the canonical database with a
# same-named schema, per environment (create it with
# docker/postgres/external-schema.sql, e.g. once with `-v db=sdkwork_ai_test`
# and once with `-v db=sdkwork_ai_prod`).
#
# GATEWAY_POSTGRES_HOST=host.docker.internal
# GATEWAY_POSTGRES_PORT=5432
# GATEWAY_POSTGRES_DB=sdkwork_ai_prod
# GATEWAY_POSTGRES_USER=sdkwork_ai_prod
# GATEWAY_POSTGRES_PASSWORD=change-me
# GATEWAY_POSTGRES_SSL_MODE=disable
#
# GATEWAY_CLOUDROUTER_REDIS_HOST=host.docker.internal
# GATEWAY_CLOUDROUTER_REDIS_PORT=6379
# GATEWAY_CLOUDROUTER_REDIS_DATABASE=0
# GATEWAY_CLOUDROUTER_REDIS_USERNAME=
# GATEWAY_CLOUDROUTER_REDIS_PASSWORD=           # leave empty for LAN passwordless
# GATEWAY_CLOUDROUTER_REDIS_TLS=false
# GATEWAY_CLOUDROUTER_REDIS_KEY_PREFIX=cloudrouter
# Set an explicit URL when RTC Redis needs authentication, TLS, or another DB.
# GATEWAY_RTC_STATE_REDIS_URL=redis://host.docker.internal:6379/1

# --- Ubuntu host-native services mode (apt-installed postgresql/redis-server) ---
# Same override file as above; the difference is only where the services run:
# the docker host itself (the Ubuntu server), reached via host.docker.internal
# (docker-compose.external.yml injects the host-gateway extra host). Built-in
# containers stay disabled. Host-side prerequisites:
#   1. PostgreSQL listens beyond 127.0.0.1 (postgresql.conf:
#      listen_addresses = '*') and pg_hba.conf allows the docker bridge
#      networks; the gateway role owns the canonical database + same-named
#      schema (run docker/postgres/external-schema.sql as superuser).
#   2. The `vector` extension must be installed on the host PostgreSQL
#      (knowledgebase module requirement): apt install
#      postgresql-14-pgvector (PG14 on Ubuntu 22.04; pick the matching
#      postgresql-XX-pgvector for the server version, e.g. PGDG repository).
#   3. Redis binds beyond 127.0.0.1 (redis.conf: bind 0.0.0.0, and disable
#      protected-mode or allow the docker bridge) so the container can reach
#      it through the host gateway address.
# Then use the values above with host.docker.internal and the per-environment
# GATEWAY_POSTGRES_DB / GATEWAY_POSTGRES_SCHEMA pair (must be equal).
