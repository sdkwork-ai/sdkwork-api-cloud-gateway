mode = "embedded"

[service]
name = "sdkwork-api-cloud-gateway"
environment = "production"

[server]
bind = "0.0.0.0:3900"

[[dependencySurfaces]]
serviceId = "sdkwork-iam-app-api"
workspace = "sdkwork-appbase"
sdkFamily = "sdkwork-iam-app-sdk"
apiAuthority = "sdkwork-iam-app-api"
surface = "app"
apiPrefix = "/app/v3/api"
runtimeMode = "embedded"
sameOriginAllowed = true
executableExport = "sdkwork_routes_iam_app_api::build_sdkwork_iam_app_api_router"
cargoFeature = "foundation-appbase"
cargoDependency = "sdkwork_routes_iam_app_api"
coverage = "appbase-iam-routes"

[[dependencySurfaces]]
serviceId = "sdkwork-drive-backend-api"
workspace = "sdkwork-drive"
sdkFamily = "sdkwork-drive-backend-sdk"
apiAuthority = "sdkwork-drive-backend-api"
surface = "backend"
apiPrefix = "/backend/v3/api/drive"
runtimeMode = "embedded"
sameOriginAllowed = true
executableExport = "sdkwork_drive_gateway_assembly::assemble_application_business_router_from_env"
cargoFeature = "foundation-drive"
cargoDependency = "sdkwork-drive-gateway-assembly"
coverage = "sdkwork-drive-backend-api-embedded-assembly-routes"

