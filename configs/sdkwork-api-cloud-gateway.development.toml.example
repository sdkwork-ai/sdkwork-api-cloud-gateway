mode = "embedded"
upstreams = []

[service]
name = "sdkwork-api-cloud-gateway"
environment = "development"

[server]
bind = "127.0.0.1:3900"

[[dependencySurfaces]]
serviceId = "sdkwork-iam-app-api"
workspace = "sdkwork-appbase"
