{
  "name": "sdkwork-api-cloud-gateway",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "cargo build --workspace",
    "check": "pnpm run check:app-composition && pnpm fmt && pnpm workflow:validate && cargo metadata --no-deps --format-version 1",
    "clean": "cargo clean",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "dev": "cargo run -p sdkwork-api-cloud-gateway --bin sdkwork-api-cloud-gateway -- --config configs/sdkwork-api-cloud-gateway.development.toml.example",
    "fmt": "cargo fmt -- --check",
    "gateway:matrix": "node ../sdkwork-github-workflow/scripts/sdkwork-workflow.mjs matrix --config sdkwork.workflow.json --profile server --platform all --architecture all --format tar.gz",
    "gateway:matrix:standalone": "pnpm gateway:matrix",
    "gateway:package:standalone": "node scripts/package-server.mjs package --deployment-profile standalone",
    "gateway:validate:standalone": "node scripts/package-server.mjs validate --deployment-profile standalone",
    "package:server": "pnpm gateway:package:standalone",
    "package:server:validate": "pnpm gateway:validate:standalone",
    "release:package": "pnpm gateway:package:standalone",
    "release:package:server": "pnpm gateway:package:standalone",
    "test": "cargo test --workspace",
    "test:iam-application-bootstrap-standard": "node scripts/dev/sdkwork-api-cloud-gateway-iam-application-bootstrap-standard.test.mjs",
    "verify": "pnpm check && pnpm test && pnpm test:iam-application-bootstrap-standard && pnpm clippy && pnpm run check:app-composition",
    "workflow:matrix:server": "pnpm gateway:matrix",
    "workflow:validate": "node ../sdkwork-github-workflow/scripts/sdkwork-workflow.mjs validate --config sdkwork.workflow.json",
    "check:app-composition": "node ../sdkwork-specs/tools/verify-repo.mjs --root ."
  }
}
