{
  "license": "AGPL-3.0-or-later",
  "name": "sdkwork-api-cloud-gateway",
  "private": true,
  "version": "0.1.11",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "scripts": {
    "stop": "pnpm exec sdkwork-app stop",
    "dev": "pnpm dev:standalone",
    "dev:standalone": "node scripts/dev/run-sdkwork-api-cloud-gateway-dev.mjs --deployment-profile standalone --environment development --database postgres",
    "dev:cloud": "node scripts/dev/run-sdkwork-api-cloud-gateway-dev.mjs --deployment-profile cloud --environment development",
    "build": "pnpm exec sdkwork-app build",
    "test": "pnpm exec sdkwork-app test",
    "check": "pnpm exec sdkwork-app check",
    "verify": "pnpm exec sdkwork-app verify",
    "clean": "pnpm exec sdkwork-app clean",
    "build:container": "node scripts/build-api-cloud-gateway-container.mjs",
    "build:container:check": "node scripts/build-api-cloud-gateway-container.mjs --check --dry-run",
    "build:container:environments": "node scripts/docker/package-environment-bundles.mjs",
    "build:container:install": "node scripts/docker/package-install-bundle.mjs",
    "check:standards": "node ../sdkwork-specs/tools/check-source-config-standard.mjs --root . && node ../sdkwork-specs/tools/check-app-manifest-standard.mjs --root . && node ../sdkwork-specs/tools/check-app-manifest-deployment-standard.mjs --root . --strict-release-targets && node ../sdkwork-specs/tools/check-agent-workflow-standard.mjs --root . && node ../sdkwork-specs/tools/check-pnpm-script-standard.mjs --root . && node ../sdkwork-specs/tools/check-repository-docs-standard.mjs --root . && node ../sdkwork-specs/tools/check-api-assembly-integration-closure.mjs --root .",
    "check:cors-standard": "node ../sdkwork-specs/tools/check-cors-standard.mjs --root .",
    "check:all-features": "cargo check -p sdkwork-api-cloud-gateway --all-features",
    "check:assembly-parity": "node ../sdkwork-specs/tools/check-api-assembly-integration-closure.mjs --root . --strict-selected-standalone-parity",
    "check:foundation-community": "cargo check -p sdkwork-api-cloud-gateway --no-default-features --features foundation-community",
    "check:foundation-suite": "cargo check -p sdkwork-api-cloud-gateway --no-default-features --features platform-foundation-suite",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "check:container-deployment": "node scripts/validate-docker-deployment.mjs --matrix --compose",
    "check:cors-carriers": "node scripts/derive-cors-allowed-origins.mjs --check",
    "db:postgres:provision": "bash bin/host/provision-external-databases.sh",
    "build:native-deps:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-libopus.ps1",
    "install:hosts": "powershell -ExecutionPolicy Bypass -File bin/host/bind-windows-hosts.ps1",
    "deploy:host:prepare": "bash bin/host/prepare-host.sh",
    "db:postgres:init": "node ../sdkwork-specs/tools/postgres/postgres-db-cli.mjs --mode init --config .env.postgres --app-root .",
    "db:postgres:plan": "node ../sdkwork-specs/tools/postgres/postgres-db-cli.mjs --mode plan --config .env.postgres --app-root . --dry-run",
    "db:pool:validate": "node ../sdkwork-specs/tools/check-process-shared-database-pool.mjs --root .",
    "db:init": "node scripts/init-database.mjs",
    "format:check": "cargo fmt -- --check",
    "gateway:matrix": "node ../sdkwork-github-workflow/scripts/sdkwork-workflow.mjs matrix --config sdkwork.workflow.json --profile server --platform all --architecture all --format tar.gz",
    "gateway:matrix:standalone": "node ../sdkwork-github-workflow/scripts/sdkwork-workflow.mjs matrix --config sdkwork.workflow.json --deployment-profile standalone --profile server --platform all --architecture all --format tar.gz",
    "gateway:matrix:cloud": "node ../sdkwork-github-workflow/scripts/sdkwork-workflow.mjs matrix --config sdkwork.workflow.json --deployment-profile cloud --profile server --platform all --architecture all --format tar.gz",
    "gateway:api:validate": "node scripts/check-gateway-api-closure.mjs --root .",
    "gateway:api:dedup:audit": "node ../sdkwork-specs/tools/check-cross-module-api-collisions.mjs --workspace ..",
    "gateway:api:dedup:strict": "node ../sdkwork-specs/tools/check-cross-module-api-collisions.mjs --workspace .. --strict",
    "gateway:package": "node scripts/package-server.mjs package",
    "gateway:package:standalone": "node scripts/package-server.mjs package --deployment-profile standalone",
    "gateway:package:cloud": "node scripts/package-server.mjs package --deployment-profile cloud",
    "gateway:validate": "node scripts/package-server.mjs validate",
    "gateway:validate:standalone": "node scripts/package-server.mjs validate --deployment-profile standalone",
    "gateway:validate:cloud": "node scripts/package-server.mjs validate --deployment-profile cloud",
    "gateway:validate:container": "node scripts/build-api-cloud-gateway-container.mjs --validate-manifest",
    "gateway:package:ci-sim": "node ../sdkwork-specs/tools/simulate-release-build.mjs --root . --steps scripts/ci-sim-verify.mjs",
    "gateway:package:ci-sim:preflight": "node ../sdkwork-specs/tools/check-dependency-list-completeness.mjs --root . && node ../sdkwork-github-workflow/scripts/sdkwork-workflow.mjs validate --config sdkwork.workflow.json",
    "gateway:package:ci-sim:package": "node ../sdkwork-specs/tools/simulate-release-build.mjs --root . --steps gateway:package:standalone",
    "test:iam-application-bootstrap-standard": "node scripts/dev/sdkwork-api-cloud-gateway-iam-application-bootstrap-standard.test.mjs",
    "test:foundation-community": "cargo test -p sdkwork-api-cloud-gateway --no-default-features --features foundation-community embedded_dependency_routes::tests::community_contribution_uses_the_process_shared_pool -- --ignored --exact",
    "workflow:matrix:server": "pnpm gateway:matrix",
    "workflow:validate": "node ../sdkwork-github-workflow/scripts/sdkwork-workflow.mjs validate --config sdkwork.workflow.json",
    "topology:validate": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs validate --root . --spec specs/topology.spec.json",
    "check:app-composition": "node ../sdkwork-specs/tools/verify-repo.mjs --root .",
    "_sdkwork:build": "cargo build --workspace",
    "_sdkwork:test": "cargo test --workspace && node --test scripts/check-gateway-api-closure.test.mjs scripts/deployment-contract.test.mjs scripts/package-server.test.mjs scripts/cors-allowed-origins.test.mjs scripts/dev/sdkwork-api-cloud-gateway-dev-cargo-env.test.mjs scripts/dev/sdkwork-api-cloud-gateway-dev-env.test.mjs scripts/dev/sdkwork-api-cloud-gateway-source-config.test.mjs && node scripts/dev/sdkwork-api-cloud-gateway-database-bootstrap-standard.test.mjs",
    "_sdkwork:check": "pnpm run check:standards && pnpm topology:validate && pnpm run check:app-composition && pnpm gateway:api:validate && pnpm db:pool:validate && pnpm check:cors-carriers && pnpm format:check && pnpm check:all-features && pnpm check:foundation-community && pnpm check:foundation-suite && pnpm workflow:validate && cargo metadata --no-deps --format-version 1",
    "_sdkwork:verify": "pnpm check && pnpm test && pnpm test:iam-application-bootstrap-standard && pnpm lint && pnpm run check:app-composition && pnpm check:cors-standard",
    "_sdkwork:clean": "cargo clean"
  },
  "devDependencies": {
    "@sdkwork/app-topology": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
