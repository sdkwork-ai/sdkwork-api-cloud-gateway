# cloud.production
SDKWORK_API_CLOUD_GATEWAY_DEPLOYMENT_PROFILE=cloud
SDKWORK_API_CLOUD_GATEWAY_ENVIRONMENT=production
SDKWORK_ENVIRONMENT=production
SDKWORK_CORS_ALLOWED_ORIGINS=https://api-gateway.sdkwork.com,https://api-gateway.birdcoder.com,https://api-gateway.dtupay.com,https://api-gateway.noaper.com,https://api-gateway.sdkwork.cn,https://api-gateway.birdcoder.cn,https://api-gateway.dtupay.cn,https://api-gateway.noaper.cn,https://api-gateway.skubc.com,https://api-gateway.skubc.cn,https://api-gateway.zowalk.com,https://api-gateway.zowalk.cn,https://api-gateway.offer86.com,https://api-gateway.offer86.cn,https://api-gateway.86offer.com,https://api-gateway.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_API_CLOUD_GATEWAY_RUNTIME_TARGET=server
SDKWORK_API_CLOUD_GATEWAY_PROFILE_ID=cloud.production
SDKWORK_API_CLOUD_GATEWAY_CONFIG_FILE=etc/sdkwork-api-cloud-gateway.production.toml
SDKWORK_API_CLOUD_GATEWAY_BIND=0.0.0.0:3900
SDKWORK_API_CLOUD_GATEWAY_PUBLIC_HTTP_URL=https://api.sdkwork.com
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_IM_PRINCIPAL_DIRECTORY=postgres

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_API_GATEWAY_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
