# cloud.development
SDKWORK_API_CLOUD_GATEWAY_DEPLOYMENT_PROFILE=cloud
SDKWORK_API_CLOUD_GATEWAY_ENVIRONMENT=development
SDKWORK_ENVIRONMENT=development
SDKWORK_CORS_ALLOWED_ORIGINS=https://api-gateway-dev.sdkwork.com,http://api-gateway-dev.sdkwork.com,https://api-gateway-dev.birdcoder.com,http://api-gateway-dev.birdcoder.com,https://api-gateway-dev.dtupay.com,http://api-gateway-dev.dtupay.com,https://api-gateway-dev.noaper.com,http://api-gateway-dev.noaper.com,https://api-gateway-dev.sdkwork.cn,http://api-gateway-dev.sdkwork.cn,https://api-gateway-dev.birdcoder.cn,http://api-gateway-dev.birdcoder.cn,https://api-gateway-dev.dtupay.cn,http://api-gateway-dev.dtupay.cn,https://api-gateway-dev.noaper.cn,http://api-gateway-dev.noaper.cn,https://api-gateway-dev.skubc.com,http://api-gateway-dev.skubc.com,https://api-gateway-dev.skubc.cn,http://api-gateway-dev.skubc.cn,https://api-gateway-dev.zowalk.com,http://api-gateway-dev.zowalk.com,https://api-gateway-dev.zowalk.cn,http://api-gateway-dev.zowalk.cn,https://api-gateway-dev.offer86.com,http://api-gateway-dev.offer86.com,https://api-gateway-dev.offer86.cn,http://api-gateway-dev.offer86.cn,https://api-gateway-dev.86offer.com,http://api-gateway-dev.86offer.com,https://api-gateway-dev.86offer.cn,http://api-gateway-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,dsh-app://app,tauri://localhost,https://servicewechat.com
SDKWORK_API_CLOUD_GATEWAY_RUNTIME_TARGET=server
SDKWORK_API_CLOUD_GATEWAY_PROFILE_ID=cloud.development
SDKWORK_API_CLOUD_GATEWAY_PUBLIC_HTTP_URL=https://api-dev.sdkwork.com
SDKWORK_IM_PRINCIPAL_DIRECTORY=postgres

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_API_GATEWAY_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Embedded knowledgebase runtime tenant. It must equal the IAM login tenant
# (sdkwork.app.config.json backend.tenantId); the runtime otherwise falls back
# to 1 and rejects every knowledge call from the deployment's own users with
# 40303 (authenticated tenant does not match configured runtime tenant).
SDKWORK_KNOWLEDGEBASE_TENANT_ID=100001

# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
