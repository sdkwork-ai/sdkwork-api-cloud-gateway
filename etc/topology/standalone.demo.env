# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_api_gateway_demo`
# and (when the base profile uses Redis) a dedicated Redis logical DB index / key prefix so no cache
# key (rate-limit, session, idempotency, ...) ever collides with another shared-redis environment.
# NOTE: demo MUST use an independent database schema `sdkwork_api_gateway_demo` for isolation.
# NOTE: if Redis is used, demo MUST target a dedicated Redis logical DB index / distinct key prefix so it never collides with other environments on shared Redis.
SDKWORK_API_CLOUD_GATEWAY_DEPLOYMENT_PROFILE=standalone
SDKWORK_API_CLOUD_GATEWAY_ENVIRONMENT=demo
SDKWORK_ENVIRONMENT=demo
SDKWORK_CORS_ALLOWED_ORIGINS=https://api-gateway-demo.sdkwork.com,http://api-gateway-demo.sdkwork.com,https://api-gateway-demo.birdcoder.com,http://api-gateway-demo.birdcoder.com,https://api-gateway-demo.dtupay.com,http://api-gateway-demo.dtupay.com,https://api-gateway-demo.noaper.com,http://api-gateway-demo.noaper.com,https://api-gateway-demo.sdkwork.cn,http://api-gateway-demo.sdkwork.cn,https://api-gateway-demo.birdcoder.cn,http://api-gateway-demo.birdcoder.cn,https://api-gateway-demo.dtupay.cn,http://api-gateway-demo.dtupay.cn,https://api-gateway-demo.noaper.cn,http://api-gateway-demo.noaper.cn,https://api-gateway-demo.skubc.com,http://api-gateway-demo.skubc.com,https://api-gateway-demo.skubc.cn,http://api-gateway-demo.skubc.cn,https://api-gateway-demo.zowalk.com,http://api-gateway-demo.zowalk.com,https://api-gateway-demo.zowalk.cn,http://api-gateway-demo.zowalk.cn,https://api-gateway-demo.offer86.com,http://api-gateway-demo.offer86.com,https://api-gateway-demo.offer86.cn,http://api-gateway-demo.offer86.cn,https://api-gateway-demo.86offer.com,http://api-gateway-demo.86offer.com,https://api-gateway-demo.86offer.cn,http://api-gateway-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,dsh-app://app,tauri://localhost,https://servicewechat.com
SDKWORK_API_CLOUD_GATEWAY_RUNTIME_TARGET=server
SDKWORK_API_CLOUD_GATEWAY_PROFILE_ID=standalone.demo
SDKWORK_API_CLOUD_GATEWAY_CONFIG_FILE=etc/sdkwork-api-cloud-gateway.development.toml
SDKWORK_API_CLOUD_GATEWAY_BIND=127.0.0.1:3900
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_IM_PRINCIPAL_DIRECTORY=postgres

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_API_GATEWAY_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
