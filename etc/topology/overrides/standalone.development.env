# SDKWork standalone.development overrides (edit this file, not the resolved profile)
SDKWORK_API_CLOUD_GATEWAY_PROFILE_ID=standalone.development
SDKWORK_API_CLOUD_GATEWAY_CONFIG_FILE=etc/sdkwork-api-cloud-gateway.development.toml
SDKWORK_API_CLOUD_GATEWAY_BIND=127.0.0.1:3900
SDKWORK_DATABASE_ENGINE=postgresql

# Embedded AIoT protocol edge (development only)
SDKWORK_AIOT_DEV_MODE=1
SDKWORK_AIOT_DEVICE_EDGE_UDP_BIND=127.0.0.1:8888
