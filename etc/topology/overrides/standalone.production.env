# SDKWork standalone.production overrides (edit this file, not the resolved profile)
SDKWORK_API_CLOUD_GATEWAY_PROFILE_ID=standalone.production

# Storage center: Tencent Cloud COS is the deployment default cloud. The Drive
# storage bootstrap runs once per process, creates one reusable account plus
# provider configuration per supported provider kind for the console tenant, and
# binds Tencent COS as that tenant's default. The operator completes the
# integration by replacing the Tencent account credential (and bucket/region)
# in the storage console; no provider has to be created by hand.
SDKWORK_DRIVE_BOOTSTRAP_STORAGE_PROVIDERS=true
SDKWORK_DRIVE_DEFAULT_STORAGE_PROVIDER=tencent_cos
SDKWORK_DRIVE_BOOTSTRAP_TENANT_ID=100001
