# SDKWork cloud.development overrides (edit this file, not the resolved profile)
SDKWORK_API_CLOUD_GATEWAY_PROFILE_ID=cloud.development
SDKWORK_API_CLOUD_GATEWAY_PUBLIC_HTTP_URL=https://api-dev.sdkwork.com
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900

# Embedded AIoT protocol edge (development only)
SDKWORK_AIOT_DEV_MODE=1
SDKWORK_AIOT_DEVICE_EDGE_UDP_BIND=127.0.0.1:8888
