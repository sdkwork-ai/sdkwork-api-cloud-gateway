{
  "schemaVersion": 3,
  "kind": "sdkwork.app",
  "app": {
    "key": "sdkwork-api-cloud-gateway",
    "name": "SDKWork API Gateway",
    "displayName": "SDKWork API Gateway",
    "description": "SDKWork platform API cloud gateway for embedded foundation API assemblies.",
    "officialWebsiteUrl": "https://sdkwork.com/apps/sdkwork-api-cloud-gateway",
    "appType": "NONE",
    "identifiers": {
      "containerImage": "sdkwork-api-cloud-gateway"
    }
  },
  "backend": {
    "primaryLanguage": "rust",
    "framework": "axum",
    "appId": "sdkwork-api-cloud-gateway",
    "serviceId": "sdkwork-api-cloud-gateway",
    "profileKey": "backend-root-admin",
    "tenantId": "100001",
    "organizationId": "0",
    "accessTokenPermissionScope": [
      "iam.users.read",
      "iam.organizations.read",
      "iam.roles.read",
      "iam.permissions.read"
    ]
  },
  "runtime": {
    "family": "server",
    "framework": "rust-axum",
    "defaultPlatform": "API",
    "defaultArchitecture": "x64",
    "supportedDeploymentProfiles": [
      "standalone",
      "cloud"
    ],
    "defaultDeploymentProfile": "standalone"
  },
  "media": {
    "icons": {
      "primary": {
        "id": "sdkwork-api-cloud-gateway-primary-icon",
        "type": "ICON",
        "purpose": "PRIMARY",
        "platform": "API",
        "format": "PNG",
        "width": 1024,
        "height": 1024,
        "enabled": false,
        "resource": {
          "kind": "catalog-media-deferred"
        }
      },
      "platform": []
    },
    "screenshots": [],
    "previews": []
  },
  "publish": {
    "status": "BETA",
    "platforms": [
      "API",
      "CLI"
    ],
    "installPlatforms": [
      "API"
    ],
    "installSkill": false
  },
  "artifacts": {
    "installConfig": {
      "defaultPackageId": "linux-x64-standalone-server-tar-gz",
      "packages": [
        {
          "id": "linux-x64-standalone-server-tar-gz",
          "name": "SDKWork API Gateway Linux x64 Server",
          "sourceType": "SCRIPT",
          "packageFormat": "TAR_GZ",
          "platform": "API",
          "architecture": "x64",
          "profileBinding": "fixed",
          "deploymentProfile": "standalone",
          "runtimeTarget": "server",
          "targetPlatform": "linux",
          "enabled": true
        },
        {
          "id": "linux-x64-cloud-server-tar-gz",
          "name": "SDKWork API Gateway Linux x64 Cloud Server",
          "sourceType": "SCRIPT",
          "packageFormat": "TAR_GZ",
          "platform": "API",
          "architecture": "x64",
          "profileBinding": "fixed",
          "deploymentProfile": "cloud",
          "runtimeTarget": "server",
          "targetPlatform": "linux",
          "enabled": true
        },
        {
          "id": "container-x64-standalone-container-oci",
          "name": "SDKWork API Gateway Linux x64 Standalone Container",
          "sourceType": "CONTAINER_IMAGE",
          "packageFormat": "DOCKER_IMAGE",
          "platform": "API",
          "architecture": "x64",
          "profileBinding": "fixed",
          "deploymentProfile": "standalone",
          "runtimeTarget": "container",
          "targetPlatform": "linux",
          "enabled": true,
          "url": "https://registry.sdkwork.com/sdkwork-api-cloud-gateway@sha256:d85647a6918315c7adab648f94b6222ba91fa8c7a90a9918b08aa5d630ad7f08",
          "checksumAlgorithm": "SHA-256",
          "checksum": "d85647a6918315c7adab648f94b6222ba91fa8c7a90a9918b08aa5d630ad7f08"
        }
      ]
    }
  },
  "release": {
    "currentVersion": "0.1.0",
    "defaultChannel": "BETA",
    "latest": {
      "BETA": "0.1.0"
    },
    "notes": [
      {
        "version": "0.1.0",
        "channel": "BETA",
        "current": true,
        "summary": "Initial SDKWork App Standard v3 gateway manifest.",
        "packageIds": [
          "linux-x64-standalone-server-tar-gz",
          "linux-x64-cloud-server-tar-gz",
          "container-x64-standalone-container-oci"
        ]
      }
    ]
  },
  "security": {
    "checksumRequired": true,
    "signatureRequired": true,
    "sbomRequired": true
  },
  "devApp": {
    "build": {
      "defaultTargetId": "linux-x64-standalone-server",
      "targets": [
        {
          "id": "linux-x64-standalone-server",
          "command": "pnpm gateway:package:standalone",
          "packageId": "linux-x64-standalone-server-tar-gz",
          "outputs": [
            {
              "path": "dist/server/sdkwork-api-cloud-gateway-0.1.0-linux-x64-standalone-server.tar.gz",
              "type": "file",
              "fileName": "sdkwork-api-cloud-gateway-0.1.0-linux-x64-standalone-server.tar.gz"
            }
          ]
        },
        {
          "id": "linux-x64-cloud-server",
          "command": "pnpm gateway:package:cloud",
          "packageId": "linux-x64-cloud-server-tar-gz",
          "outputs": [
            {
              "path": "dist/server/sdkwork-api-cloud-gateway-0.1.0-linux-x64-cloud-server.tar.gz",
              "type": "file",
              "fileName": "sdkwork-api-cloud-gateway-0.1.0-linux-x64-cloud-server.tar.gz"
            }
          ]
        }
      ]
    },
    "upload": {
      "strategy": "backend-presigned-put",
      "scene": "apps",
      "bucket": "sdkwork-apps",
      "objectKeyTemplate": "apps/{appKey}/{env}/{version}/{targetId}.tar.gz"
    }
  },
  "metadata": {
    "deploymentConfig": "etc/sdkwork.deployment.config.json",
    "componentSpec": "specs/component.spec.json",
    "topologySpec": "specs/topology.spec.json",
    "workflowManifest": "sdkwork.workflow.json"
  }
}
