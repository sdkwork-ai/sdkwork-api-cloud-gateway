  "toolchains": {
    "node": "22",
    "pnpm": "10.33.0",
    "rust": "stable"
  },
  "lifecycle": {
    "build": [
      {
        "name": "Verify Rust gateway workspace",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\n$PSNativeCommandUseErrorActionPreference = $true\n$env:CARGO_INCREMENTAL = \"0\"\npnpm check:assembly-parity\ncargo fmt -- --check\ncargo test --workspace"
      }
    ],
    "package": [
      {
        "name": "Package server archive",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\n$PSNativeCommandUseErrorActionPreference = $true\n$env:CARGO_INCREMENTAL = \"0\"\nif ($env:SDKWORK_RUNTIME_TARGET -eq \"container\") {\n  $imageTag = \"$($env:SDKWORK_CONTAINER_IMAGE_REPOSITORY):$($env:SDKWORK_PACKAGE_VERSION)-$($env:SDKWORK_DEPLOYMENT_PROFILE)\"\n  node scripts/build-api-cloud-gateway-container.mjs --version $env:SDKWORK_PACKAGE_VERSION --deployment-profile $env:SDKWORK_DEPLOYMENT_PROFILE --tag $imageTag --push\n  exit $LASTEXITCODE\n}\npnpm gateway:package",
        "env": {
          "SDKWORK_CONTAINER_IMAGE_REPOSITORY": "registry.sdkwork.com/sdkwork-api-cloud-gateway"
        }
      }
    ],
    "sign": [
      {
        "name": "Create detached artifact signature",
        "shell": "bash",
        "run": "node scripts/release-evidence.mjs sign"
      }
    ],
    "sbom": [
      {
        "name": "Generate CycloneDX SBOM",
        "shell": "bash",
        "run": "node scripts/release-evidence.mjs sbom"
      }
    ],
    "validate": [
      {
        "name": "Validate server archive",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\n$PSNativeCommandUseErrorActionPreference = $true\nif ($env:SDKWORK_RUNTIME_TARGET -eq \"container\") {\n  node scripts/build-api-cloud-gateway-container.mjs --validate-manifest --require-repo-digest --version $env:SDKWORK_PACKAGE_VERSION --deployment-profile $env:SDKWORK_DEPLOYMENT_PROFILE\n} else {\n  pnpm gateway:validate\n}\nif ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }\nnode scripts/release-evidence.mjs evidence\nif ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }\nnode scripts/release-evidence.mjs verify"
      }
    ]
  },
