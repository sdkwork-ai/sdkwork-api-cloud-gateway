  "toolchains": {
    "node": "22",
    "pnpm": "10.33.0",
    "rust": "stable"
  },
  "lifecycle": {
    "build": [
      {
        "name": "Verify Rust gateway workspace",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\n$PSNativeCommandUseErrorActionPreference = $true\n$env:CARGO_INCREMENTAL = \"0\"\ncargo fmt -- --check\ncargo test --workspace"
      }
    ],
    "package": [
      {
        "name": "Package server archive",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\n$PSNativeCommandUseErrorActionPreference = $true\n$env:CARGO_INCREMENTAL = \"0\"\npnpm gateway:package"
      }
    ],
    "sign": [
      {
        "name": "Signing policy placeholder",
        "shell": "node",
        "run": "console.log(`Signing is not required for ${process.env.SDKWORK_PACKAGE_ID}.`);"
      }
    ],
    "sbom": [
      {
        "name": "SBOM policy placeholder",
        "shell": "node",
        "run": "console.log(`SBOM generation is not required for ${process.env.SDKWORK_PACKAGE_ID}.`);"
      }
    ],
    "validate": [
      {
        "name": "Validate server archive",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\n$PSNativeCommandUseErrorActionPreference = $true\npnpm gateway:validate"
      }
    ]
  },
  "targets": [
    {
      "id": "linux-x64-standalone-server-tar-gz",
      "profile": "server",
      "platform": "linux",
      "architecture": "x64",
      "formats": [
        "tar.gz"
      ],
      "runner": "ubuntu-24.04",
      "deploymentProfile": "standalone",
      "runtimeTarget": "server",
      "outputGlobs": [
        "dist/server/sdkwork-api-cloud-gateway-*-linux-x64-standalone-server.tar.gz"
      ]
    },
    {
      "id": "linux-x64-cloud-server-tar-gz",
      "profile": "server",
      "platform": "linux",
      "architecture": "x64",
      "formats": [
        "tar.gz"
      ],
      "runner": "ubuntu-24.04",
      "deploymentProfile": "cloud",
      "runtimeTarget": "server",
      "outputGlobs": [
        "dist/server/sdkwork-api-cloud-gateway-*-linux-x64-cloud-server.tar.gz"
      ]
    }
  ],
  "security": {
    "artifactAttestations": true,
    "sbomRequired": false,
    "signingRequired": false
  },
  "publish": {
    "workflowArtifact": true,
    "githubRelease": true,
    "retentionDays": 30
  }
}
