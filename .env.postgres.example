# SDKWork API Gateway local PostgreSQL development profile.
# Copy to .env.postgres and replace every <CHANGE_ME> value. Never commit .env.postgres.

SDKWORK_CLAW_DATABASE_ENGINE=postgresql
SDKWORK_CLAW_DATABASE_HOST=127.0.0.1
SDKWORK_CLAW_DATABASE_PORT=5432
SDKWORK_CLAW_DATABASE_NAME=sdkwork_ai_dev
SDKWORK_CLAW_DATABASE_SCHEMA=sdkwork_api_cloud_gateway_dev
SDKWORK_CLAW_DATABASE_USERNAME=sdkwork_ai_dev
SDKWORK_CLAW_DATABASE_PASSWORD=<CHANGE_ME>
SDKWORK_CLAW_DATABASE_SSL_MODE=disable
SDKWORK_CLAW_DATABASE_MAX_CONNECTIONS=10

# Used only by the local initializer to ensure the role, database, and schema exist.
SDKWORK_CLAW_DATABASE_ADMIN_HOST=127.0.0.1
SDKWORK_CLAW_DATABASE_ADMIN_PORT=5432
SDKWORK_CLAW_DATABASE_ADMIN_USERNAME=postgres
SDKWORK_CLAW_DATABASE_ADMIN_PASSWORD=<CHANGE_ME>
SDKWORK_CLAW_DATABASE_ADMIN_DATABASE=postgres
SDKWORK_CLAW_DATABASE_ADMIN_SSL_MODE=disable

# Optional direct URLs take precedence over the split fields above.
# SDKWORK_CLAW_DATABASE_URL=postgresql://sdkwork_ai_dev:<CHANGE_ME>@127.0.0.1:5432/sdkwork_ai_dev?sslmode=disable
# SDKWORK_CLAW_DATABASE_ADMIN_URL=postgresql://postgres:<CHANGE_ME>@127.0.0.1:5432/postgres?sslmode=disable
